// Copy this file to arduino_secrets.h and fill in your values.
// arduino_secrets.h is gitignored - never commit real WiFi credentials.

#define SECRET_SSID "your_wifi_ssid"
#define SECRET_PASS "your_wifi_password"

// Must be unique across the team, and must match what you registered
// with `./skill.sh name <yourname>` in the mqtt-grounding skill.
#define DEVICE_NAME "yourname"

// The grounding broker's current LAN IP (changes if DHCP reassigns it -
// check with ipconfig / ifconfig if the board can't connect).
#define MQTT_HOST "192.168.0.35"
#define MQTT_PORT 1883
